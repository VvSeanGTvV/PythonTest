class cipherModule():
    Shift = 0
    def __init__(self, shift:int):
        self.Shift = shift

    def encode(self, entry:str):
        EncodedMessage = ""
        for i in range(len(entry)):
            readyShift = 0
            letter = entry[i % len(entry)]
            if (letter.islower() or letter.isupper() and (ord(letter) > 65)):
                readyShift = self.Shift
                #EncodedMessage = EncodedMessage + chr(((ord(entry[i % len(entry)]) - ord('a') + readyShift % 26 + ord('a'))))
            else:
                EncodedMessage = EncodedMessage + entry[i % len(entry)]
        return EncodedMessage
    
    def decode(self, encoded:str):
        DecodedMessage = ""
        for i in range(len(encoded)):
            readyShift = 0
            letter = encoded[i % len(encoded)]
            if ((letter.islower() or letter.isupper()) and (ord(letter) > 65)):
                readyShift = self.Shift
                #if (letter.isupper()): readyShift = readyShift - 6
                code = chr(ord(encoded[i % len(encoded)]) + ord('a') - readyShift % 26 - ord('a'))
                offset = 0
                if (letter.isupper()): 
                    leftover = 0
                    if (ord(code) < 65): 
                        leftover = -(65 - ord(code))
                        offset
                        code = chr(90 - leftover + offset)
                    if (ord(code) > 90): 
                        leftover = ord(code) - 90 
                        code = chr(65 + leftover + offset)
                else:
                    leftover = 0
                    if (ord(code) < 97): 
                        leftover = -(97 - ord(code))
                        code = chr(122 - leftover + offset)
                    if (ord(code) > 122): 
                        leftover = ord(code) - 122
                        code = chr(97 + leftover + offset)

                DecodedMessage = DecodedMessage + code
                #DecodedMessage = DecodedMessage + chr(((ord(encoded[i % len(encoded)]) + ord('a') - readyShift % 26 - ord('a'))))
            else:
                DecodedMessage = DecodedMessage + encoded[i % len(encoded)]
        return DecodedMessage

